{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "7c2da497-6377-445e-a913-a8c05ffeab40"
  },
  "newProjectRoot": "projects",
  "projects": {
    "Lecture_1": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/lecture-1",
      "sourceRoot": "projects/lecture-1/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/lecture-1/src/main.ts",
            "tsConfig": "projects/lecture-1/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/lecture-1/public"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "projects/lecture-1/src/styles.css"
            ],
            "polyfills": ["@angular/localize/init"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Lecture_1:build:production"
            },
            "development": {
              "buildTarget": "Lecture_1:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "Lecture_2": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/lecture-2",
      "sourceRoot": "projects/lecture-2/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/lecture-2/src/main.ts",
            "tsConfig": "projects/lecture-2/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/lecture-2/public"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "projects/lecture-2/src/styles.css"
            ],
            "polyfills": ["@angular/localize/init"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Lecture_2:build:production"
            },
            "development": {
              "buildTarget": "Lecture_2:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
